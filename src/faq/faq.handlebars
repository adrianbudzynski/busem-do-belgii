<div class="container u-space-3">
    <div class="row">
        <div class="w-md-80 w-lg-50 text-center mx-auto mb-9">
            <span class="u-label u-label--sm u-label--success mb-2">FAQ</span>
            <h2 class="text-primary">Zapoznaj się z <span class="font-weight-bold">częstymi pytaniami naszych klientów</span></h2>
            <!--<p>Enhance your brand with easy to use powerful customization features.</p>-->
        </div>
    </div>
    <div class="row">
        <div id="stickyBlockStartPoint" class="col-lg-3 mb-9 mb-lg-0">
            <nav class="js-sticky-block bg-primary shadow-primary-sm rounded"
                 data-has-sticky-header="true"
                 data-offset-target="#logoAndNav"
                 data-sticky-view="lg"
                 data-start-point="#stickyBlockStartPoint"
                 data-end-point="#stickyBlockEndPoint"
                 data-offset-top="24"
                 data-offset-bottom="24">
                <ul id="scrollNav" class="list-unstyled u-list u-list--white py-3 px-5">
                    <li class="py-2">
                        <a class="d-block u-list__link js-go-to" href="#podstawowe">Podstawowe</a>
                    </li>
                    <li class="py-2">
                        <a class="d-block u-list__link js-go-to" href="#przewoz-osob">Przewóz osób</a>
                    </li>
                    <li class="py-2">
                        <a class="d-block u-list__link js-go-to" href="#paczki">Paczki i przesyłki</a>
                    </li>
                    <li class="py-2">
                        <a class="d-block u-list__link js-go-to" href="#grupy">Obsługa zorganizowanych grup</a>
                    </li>
                </ul>
            </nav>
        </div>

        <div class="col-lg-9">
            <div id="podstawowe" class="u-space-2-bottom">
                <div class="mb-3">
                    <h3 class="text-primary font-weight-bold">Podstawowe</h3>
                </div>

                <div id="basicsAccordion">
                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="basicsHeadingOne">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn p-3"
                                        data-toggle="collapse"
                                        data-target="#basicsCollapseOne"
                                        aria-expanded="true"
                                        aria-controls="basicsCollapseOne">
                                    W jakie dni jezdzimy do Belgii, Holandii bądź Niemiec??

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="basicsCollapseOne" class="collapse show"
                             aria-labelledby="basicsHeadingOne"
                             data-parent="#basicsAccordion">
                            <div class="card-body u-card-body">
                                We wtorek i piątek.
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="basicsHeadingTwo">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn collapsed p-3"
                                        data-toggle="collapse"
                                        data-target="#basicsCollapseTwo"
                                        aria-expanded="false"
                                        aria-controls="basicsCollapseTwo">
                                    W jakie dni wracamy do Polski?

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="basicsCollapseTwo" class="collapse"
                             aria-labelledby="basicsHeadingTwo"
                             data-parent="#basicsAccordion">
                            <div class="card-body u-card-body">
                               W środę oraz sobotę.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-0">

            <div id="przewoz-osob" class="u-space-2">
                <div class="mb-3">
                    <h3 class="text-primary font-weight-bold">Przewóz osób</h3>
                </div>

                <div id="syncingAccordion">
                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="po1">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn p-3"
                                        data-toggle="collapse"
                                        data-target="#poc1"
                                        aria-expanded="false"
                                        aria-controls="poc1">
                                    Jakimi busami jeździmy?

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="poc1" class="collapse show"
                             aria-labelledby="po1"
                             data-parent="#syncingAccordion">
                            <div class="card-body u-card-body">
                                Mercedes Sprinter i Renault Master
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="po2">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn collapsed p-3"
                                        data-toggle="collapse"
                                        data-target="#poc2"
                                        aria-expanded="false"
                                        aria-controls="poc2">
                                    Czy dowozimy na adres?

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="poc2" class="collapse"
                             aria-labelledby="po2"
                             data-parent="#po2">
                            <div class="card-body u-card-body">
                                Tak
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="po3">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn collapsed p-3"
                                        data-toggle="collapse"
                                        data-target="#poc3"
                                        aria-expanded="false"
                                        aria-controls="poc3">
                                    Ile można mieć bagaży?

                                    <span class="u-card-btn__arrow">
                                        <span class="fa fa-arrow-down small"></span>
                                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="poc3" class="collapse"
                             aria-labelledby="po3"
                             data-parent="#syncingAccordion">
                            <div class="card-body u-card-body">
                                2 torby plus bagaż podręczny.
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="poq3">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn collapsed p-3"
                                        data-toggle="collapse"
                                        data-target="#pocq3"
                                        aria-expanded="false"
                                        aria-controls="pocq3">
                                    Czy można przewozić dzieci poniżej 12 roku życia?

                                    <span class="u-card-btn__arrow">
                                        <span class="fa fa-arrow-down small"></span>
                                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="pocq3" class="collapse"
                             aria-labelledby="poq3"
                             data-parent="#syncingAccordion">
                            <div class="card-body u-card-body">
                                Tak, lecz informację taką muszą Państwo przekazać podczas dokonywania rezerwacji. Przygotujemy wtedy specjalnie fotlik dla dziecka na czas przejazdu.
                            </div>
                        </div>
                    </div>


                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="po4">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn collapsed p-3"
                                        data-toggle="collapse"
                                        data-target="#poc4"
                                        aria-expanded="false"
                                        aria-controls="poc4">
                                    Czy potrzebuję jakichś dokumentów, aby przekroczyć granicę?

                                    <span class="u-card-btn__arrow">
                                        <span class="fa fa-arrow-down small"></span>
                                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="poc4" class="collapse"
                             aria-labelledby="po4"
                             data-parent="#syncingAccordion">
                            <div class="card-body u-card-body">
                                Tak, pasażer zobowiązany jest do posiadania dokumentów uprawniających go do przekraczania granicy. Dowód osobisty lub paszport.
                            </div>
                        </div>
                    </div>


                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="po5">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn collapsed p-3"
                                        data-toggle="collapse"
                                        data-target="#poc5"
                                        aria-expanded="false"
                                        aria-controls="poc5">
                                    Czy podczas podróży można spożywać alkohol?

                                    <span class="u-card-btn__arrow">
                                        <span class="fa fa-arrow-down small"></span>
                                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="poc5" class="collapse"
                             aria-labelledby="po5"
                             data-parent="#syncingAccordion">
                            <div class="card-body u-card-body">
                                Nie, podczas poroży obowiązuje całkowity zakaz spożywania alkoholu.
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="po6">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn collapsed p-3"
                                        data-toggle="collapse"
                                        data-target="#poc6"
                                        aria-expanded="false"
                                        aria-controls="poc6">
                                    Czy mogę zabrać ze sobą dodatkowy bagaż wykraczający poza limit ustalony w regulaminie?

                                    <span class="u-card-btn__arrow">
                                        <span class="fa fa-arrow-down small"></span>
                                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="poc6" class="collapse"
                             aria-labelledby="poc6"
                             data-parent="#syncingAccordion">
                            <div class="card-body u-card-body">
                                Tak, za nadbagaż zostanie naliczona dodatkowa opłata.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <hr class="my-0">

            <div id="paczki" class="u-space-2">
                <div class="mb-3">
                    <h3 class="text-primary font-weight-bold">Paczki i przesyłki</h3>
                </div>

                <div id="accountAccordion">
                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="accountHeadingOne">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn p-3"
                                        data-toggle="collapse"
                                        data-target="#accountCollapseOne"
                                        aria-expanded="false"
                                        aria-controls="accountCollapseOne">
                                    Czy paczka może zawierać dowolne towary?

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="accountCollapseOne" class="collapse show"
                             aria-labelledby="accountHeadingOne"
                             data-parent="#accountAccordion">
                            <div class="card-body u-card-body">
                                Nie, zabrania się przewozu alkoholu, wyrobów tytoniowych, narkotyków oraz broni.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-0">

            <div id="grupy" class="u-space-2-top">
                <div class="mb-3">
                    <h3 class="text-primary font-weight-bold">Obsługa zorganizowanych grup</h3>
                </div>

                <div id="privacyAccordion">
                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="privacyHeadingOne">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn p-3"
                                        data-toggle="collapse"
                                        data-target="#privacyCollapseOne"
                                        aria-expanded="false"
                                        aria-controls="privacyCollapseOne">
                                    Czy można zamówić transport na wesele?

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="privacyCollapseOne" class="collapse show"
                             aria-labelledby="privacyHeadingOne"
                             data-parent="#privacyAccordion">
                            <div class="card-body u-card-body">
                                Tak, prosimy o kontakt w celu uzgodnienia szczegółów.
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="pp2">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn p-3"
                                        data-toggle="collapse"
                                        data-target="#ppc2"
                                        aria-expanded="false"
                                        aria-controls="ppc2">
                                    Czy można zamówić transport na konferencję?

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="ppc2" class="collapse show"
                             aria-labelledby="pp2"
                             data-parent="#privacyAccordion">
                            <div class="card-body u-card-body">
                                Tak, prosimy o kontakt w celu uzgodnienia szczegółów.
                            </div>
                        </div>
                    </div>


                    <div class="card mb-3">
                        <div class="card-header u-card-header" id="pp3">
                            <h5 class="mb-0">
                                <button class="btn btn-link btn-block d-flex justify-content-between u-card-btn p-3"
                                        data-toggle="collapse"
                                        data-target="#ppc3"
                                        aria-expanded="false"
                                        aria-controls="ppc3">
                                    Czy można zamówić transport na imprezę firmową?

                                    <span class="u-card-btn__arrow">
                        <span class="fa fa-arrow-down small"></span>
                      </span>
                                </button>
                            </h5>
                        </div>
                        <div id="ppc3" class="collapse show"
                             aria-labelledby="pp3"
                             data-parent="#privacyAccordion">
                            <div class="card-body u-card-body">
                                Tak, prosimy o kontakt w celu uzgodnienia szczegółów.
                            </div>
                        </div>
                    </div>



                </div>
            </div>
        </div>
    </div>
</div>

<div id="stickyBlockEndPoint"></div>



{{#section 'scripts'}}
    <script src="assets/js/components/hs.sticky-block.js"></script>
    <script src="assets/js/components/hs.scroll-nav.js"></script>
    <script>
        $(window).on('load', function () {
            $.HSCore.components.HSScrollNav.init($('#scrollNav'), {
                duration: 700
            });
        });
        $(document).on('ready', function () {
            setTimeout(function () {
                $.HSCore.components.HSStickyBlock.init('.js-sticky-block');
            }, 300);
        });
    </script>
{{/section}}
